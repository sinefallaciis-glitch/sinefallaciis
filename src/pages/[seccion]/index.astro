---
// Listado de una sección (p. ej. /falacias/)
import Base from '../../layouts/Base.astro';
import { secciones, getSeccion } from '../../data/secciones';
import { fichasDe } from '../../data/contenido';

export function getStaticPaths() {
  return secciones.map((s) => ({ params: { seccion: s.id } }));
}

const seccion = getSeccion(Astro.params.seccion!);
const fichas = await fichasDe(seccion.id);
---

<Base titulo={seccion.nombre} descripcion={seccion.descripcion}>
  <p class="antetitulo">Sección</p>
  <h1>{seccion.nombre}</h1>
  <p class="lema" style="color: var(--tinta-suave); font-size: 1.2rem; max-width: 40rem;">{seccion.descripcion}</p>

  {fichas.length === 0 ? (
    <p class="caja">Todavía no hay nada aquí. Pronto.</p>
  ) : (
    <ul class="rejilla">
      {fichas.map((f) => (
        <li>
          <a class="tarjeta" href={`/${seccion.id}/${f.id}/`}>
            <h3>{f.data.titulo}</h3>
            <p>{f.data.resumen}</p>
            {f.data.etiquetas.length > 0 && (
              <div class="meta">{f.data.etiquetas.map((e) => <span class="etiqueta">{e}</span>)}</div>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
